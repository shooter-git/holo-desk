# HO[LO] Desk settings. Copy this file to .env (which is never committed) and change what you need.
# Nothing here is a secret: HO[LO] needs no keys or passwords.

# Where HO[LO] keeps its database, projects and sample packs: a folder on this machine.
HOLO_DATA_DIR=./data

# The port HO[LO] listens on. It is only open on this machine (127.0.0.1); your other devices reach it
# over HTTPS on your tailnet (`pnpm tailnet on`), because browsers only allow MIDI on a secure page.
HOLO_PORT=47800

# The HTTPS port `pnpm tailnet on` opens on your tailnet: https://<this machine>.<tailnet>.ts.net:47801
HOLO_TAILNET_HTTPS=47801

# The folder that holds your creations (each with a holo.creation.json at its root), so songs can go
# back and forth between HO[LO] and them. Leave empty if you have none.
HOLO_CREATIONS_DIR=

# The user and group the container writes files as: yours, so the session files it writes into your
# creations stay yours. `id -u` and `id -g` print them.
HOLO_UID=1000
HOLO_GID=1000

# HTTPS on your local network for devices without Tailscale (`pnpm lan on`). Anyone on the network can
# use HO[LO] while it's on. The HTTPS port, and the port that hands out the certificate to install.
HOLO_LAN_HTTPS=47843
HOLO_LAN_CA=47844

# Other names the studio is reached by, besides this machine, your local network and your tailnet
# (which always work): a reverse proxy's name, say. Comma-separated; each a host (holo.example.com),
# host:port, or an origin (https://holo.example.com). Pages and requests for any other name can't use
# the live channel or the agent.
HOLO_ALLOWED_HOSTS=

# Network MIDI (an iPhone's or iPad's USB keyboard, a Mac's network session) on UDP 5004 and 5005.
# Who can reach it: 127.0.0.1 (this machine only), this machine's tailnet address, or 0.0.0.0 (your
# whole network). `pnpm netmidi on | lan | off` sets it. Run without Docker, set HOLO_NETWORK_MIDI=on.
HOLO_NETWORK_MIDI_BIND=127.0.0.1

# Updates (pnpm run update / pnpm run autoupdate on): which image CI publishes to follow. stable: each
# release; main: every change merged. HOLO_IMAGE is written by `pnpm run update` (the published image)
# and `pnpm run up` (holo-desk:local, built from this checkout, while auto-update waits).
HOLO_CHANNEL=stable
