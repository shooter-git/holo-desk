# HO[LO] Desk settings. Copy this file to .env (which is never committed) and change what you need.
# Nothing here is a secret: HO[LO] needs no API keys, accounts or passwords. The one key it uses, the
# runner's (runner.key in the data folder), the server makes by itself the first time it starts.

# Where HO[LO] keeps its database, projects and sample packs: a folder on this machine.
HOLO_DATA_DIR=./data

# The port HO[LO] listens on. It is only open on this machine (127.0.0.1); your other devices reach it
# over HTTPS on your tailnet (`pnpm tailnet on`), because browsers only allow MIDI on a secure page.
HOLO_PORT=47800

# The HTTPS port `pnpm tailnet on` opens on your tailnet: https://<this machine>.<tailnet>.ts.net:47801
HOLO_TAILNET_HTTPS=47801

# The folder that holds your creations (each with a holo.creation.json at its root), so songs can go
# back and forth between HO[LO] and them. Left empty, Docker uses ./data/creations (and so does the
# runner).
HOLO_CREATIONS_DIR=

# The user and group the container writes files as: yours, so the session files it writes into your
# creations stay yours. `id -u` and `id -g` print them.
HOLO_UID=1000
HOLO_GID=1000

# HTTPS on your local network for devices without Tailscale (`pnpm lan on`). Anyone on the network can
# use HO[LO] while it's on. The HTTPS port, and the port that hands out the certificate to install.
HOLO_LAN_HTTPS=47843
HOLO_LAN_CA=47844

# Other names the studio is reached by, besides this machine, your local network and your tailnet
# (which always work): a reverse proxy's name, say. Comma-separated, spaces around each ignored. Each
# entry is one of:
#   holo.example.com            a host name: pages from it on any port
#   holo.example.com:8443       a host and port: pages from that port only
#   https://holo.example.com    an origin: pages from that scheme, name and port only
# Requests for the name are let in whichever form names it. Pages from any other site, and requests
# for any other name, can't use the live channel or the agent. Example:
#   HOLO_ALLOWED_HOSTS=holo.example.com,https://music.example.org:8443
HOLO_ALLOWED_HOSTS=

# A bounce made on the host (for a phone or a tablet, or any device set to) is rendered on its
# cores: one fewer than it has, six at most, and the file is the same as on one. On a computer that
# has other work to do, this is the most threads a bounce may use (1: one, as before). Not set: as
# many as its cores allow.
HOLO_BOUNCE_THREADS=

# Network MIDI (an iPhone's or iPad's USB keyboard, a Mac's network session) on UDP 5004 and 5005.
# Who can reach it: 127.0.0.1 (this machine only), this machine's tailnet address, or 0.0.0.0 (your
# whole network). `pnpm netmidi on | lan | off` sets it. Run without Docker, set HOLO_NETWORK_MIDI=on.
HOLO_NETWORK_MIDI_BIND=127.0.0.1

# The recognition engines, which read scanned sheet music into songs (Audiveris and homr, in a container
# with no way out to the internet), are on: `pnpm omr off` turns them off and writes what that takes here
# (HOLO_OMR_URL empty), `pnpm omr on` turns them back on. In Docker they run beside the studio; run
# without Docker, the server starts them itself (when the computer has Docker) the first time a scan
# wants them. The first start fetches them: a few GB.

# Updates (pnpm run update / pnpm run autoupdate on): which image CI publishes to follow. stable: each
# release; main: every change merged. HOLO_IMAGE is written by `pnpm run update` (the published image)
# and `pnpm run up` (holo-desk:local, built from this checkout, while auto-update waits).
# When a new version doesn't start, the update goes back to the one before and writes it here too:
# HOLO_IMAGE=holo-desk:previous, HOLO_ROLLED_BACK_FROM (the image that didn't start) and
# HOLO_ROLLED_BACK_IMAGE (the one it was following). Leave them: the next newer version, or `pnpm run
# update` by hand, takes them out again.
HOLO_CHANNEL=stable
